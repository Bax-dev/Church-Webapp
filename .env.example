# Copy to .env.local for development. In production set these in the host's environment (PRD §13).
DATABASE_URL=postgresql://user:pass@localhost:5432/church
REDIS_URL=redis://localhost:6379

# Long random strings, different from each other: `openssl rand -base64 48`
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Used in emailed links.
APP_URL=http://localhost:3000

# Leave SMTP_HOST empty in development: emails (with their links) are printed to the server console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Presbyterian Centre <no-reply@example.org>"
# Development only, with SMTP_HOST empty: also append each email to this file.
MAIL_OUTBOX=

# Where profile photos are stored on disk.
UPLOAD_DIR=uploads

# Object storage (src/lib/server/s3.ts, not wired in yet). S3_ENDPOINT and S3_FORCE_PATH_STYLE=true
# only for S3-compatible providers such as Cloudflare R2 or MinIO. Leave the keys empty to use an IAM role.
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional public base URL (CDN or public bucket) for storage.publicUrl().
S3_PUBLIC_URL=

# Resend (src/lib/server/resend.ts, not wired in yet). Empty key: emails are printed to the console.
RESEND_API_KEY=
# Must be on a domain verified in Resend. Defaults to EMAIL_FROM.
RESEND_FROM=

# `yarn db:seed` creates this Super Admin if they do not exist yet.
SEED_ADMIN_EMAIL=admin@example.org
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FIRST_NAME=Church
SEED_ADMIN_LAST_NAME=Office
